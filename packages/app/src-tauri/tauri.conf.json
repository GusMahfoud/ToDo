{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TodoMCP",
  "mainBinaryName": "todomcp",
  "version": "0.1.0",
  "identifier": "com.example.todomcp",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "TodoMCP",
        "width": 980,
        "height": 660,
        "minWidth": 360,
        "minHeight": 420,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Todo list with a built-in MCP server for AI clients",
    "licenseFile": "../../../TERMS.txt",
    "longDescription": "TodoMCP is a local-first todo app that doubles as an MCP server, so Cursor, Claude Code, Claude Desktop and other AI clients can read and write your todos.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/todo-mcp"],
    "createUpdaterArtifacts": false,
    "linux": {
      "deb": { "depends": [] },
      "rpm": { "depends": [] }
    },
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
